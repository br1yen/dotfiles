# Typography
font=Hack 12

# Layout & Geometry
anchor=top-right
layer=overlay
width=340
height=110
padding=12,16
border-size=1
border-radius=0
default-timeout=4000

# Base Colors
background-color=#242424ff
text-color=#cdcdcdff
border-color=#000000ff

# Urgency: Low
[urgency=low]
background-color=#242424ff
text-color=#646477ff
border-color=#000000ff
default-timeout=2500

# Urgency: Normal
[urgency=normal]
background-color=#242424ff
text-color=#dedee6ff
border-color=#000000ff

# Urgency: Critical
[urgency=critical]
background-color=#242424ff
text-color=#dedee6ff
border-color=#000000ff
default-timeout=0
