# Typography
font=Adwaita Sans 10

# Layout & Geometry
anchor=top-right
layer=overlay
width=340
height=110
padding=12,16
border-size=1
border-radius=0
default-timeout=4000

# Icons
icons=1
icon-path=/usr/share/icons/Colloid-Dark/

# Base Colors
background-color=#303030ff
text-color=#d0d0d0ff
border-color=#000000ff

# Urgency: Low
[urgency=low]
background-color=#242424ff
text-color=#646477ff
border-color=#000000ff
default-timeout=2500

# Urgency: Normal
[urgency=normal]
background-color=#242424ff
text-color=#dedee6ff
border-color=#000000ff

# Urgency: Critical
[urgency=critical]
background-color=#242424ff
text-color=#dedee6ff
border-color=#000000ff
default-timeout=0
