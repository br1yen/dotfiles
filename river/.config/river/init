#!/bin/sh
export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_TYPE=wayland

dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

case "$(uname -n)" in
  theworld) wlr-randr --output DP-3 --mode 1920x1080@179.998001Hz ;;
  lovetrain) wlr-randr --output eDP-1 --mode 1920x1080@60.012001Hz ;;
esac

nm-applet &
steam --silent &
sfwbar &
    
exec /home/br1yen/tinyrwm/c/build/tinyrwm
