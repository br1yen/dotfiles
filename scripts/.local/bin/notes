#!/usr/bin/env sh
# typc: combine every .typ in a class folder into <notes>/pdfs/<class>.pdf
# usage: typc [class_dir]   (default: current directory)

dir=$(realpath "${1:-.}")
class=$(basename "$dir")
out="$(dirname "$dir")/pdfs"
mkdir -p "$out"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

set --
for f in "$dir"/*.typ; do
    pdf="$tmp/$(basename "${f%.typ}").pdf"
    typst compile --root "$(dirname "$dir")" "$f" "$pdf" || exit 1
    set -- "$@" "$pdf"
done

if [ $# -eq 1 ]; then
    cp "$1" "$out/$class.pdf"
else
    pdfunite "$@" "$out/$class.pdf"
fi && echo "wrote $out/$class.pdf"
