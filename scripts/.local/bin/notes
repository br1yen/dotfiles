#!/usr/bin/env sh
# typc: combine every .typ in a class folder into $NOTES/pdfs/<class>.pdf
# usage: typc [class_dir | class_name]   (default: current directory)

NOTES="${NOTES:-$HOME/sync/school/notes}"   # <- set this to your notes root

arg="${1:-.}"
if [ -d "$arg" ]; then
    dir=$(realpath "$arg")
elif [ -d "$NOTES/$arg" ]; then
    dir=$(realpath "$NOTES/$arg")      # lets you run `typc csc373` from anywhere
else
    echo "typc: no such class folder: $arg" >&2
    exit 1
fi

class=$(basename "$dir")
out="$NOTES/pdfs"
mkdir -p "$out"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

set --
for f in "$dir"/*.typ; do
    [ -e "$f" ] || { echo "typc: no .typ files in $dir" >&2; exit 1; }
    pdf="$tmp/$(basename "${f%.typ}").pdf"
    typst compile --root "$NOTES" "$f" "$pdf" || exit 1
    set -- "$@" "$pdf"
done

if [ $# -eq 1 ]; then
    cp "$1" "$out/$class.pdf"
else
    pdfunite "$@" "$out/$class.pdf"
fi && echo "wrote $out/$class.pdf"
