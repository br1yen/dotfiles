#!/usr/bin/env bash

TODO="${TODO:-$HOME/sync/notes/todo.md}"
ESC=$'\033'

AWK_LIB=$(cat <<'EOF'
function jd(y,m,d) {
  if (m <= 2) {
    y--
    m += 12
  }
  return int(365.25*y) + int(30.6001*(m+1)) + d
}

function paint(kind, n) {
  if (kind == "due") {
    if (n < 0)
      return "\033[1;38;2;196;127;136m"
    if (n == 0)
      return "\033[1;38;2;216;197;143m"
    if (n <= 7)
      return "\033[38;2;196;183;127m"
    return "\033[38;2;120;151;127m"
  }

  if (n < 0)
    return "\033[1;38;2;181;139;158m"
  if (n == 0)
    return "\033[1;38;2;137;175;188m"
  if (n == 1)
    return "\033[1;38;2;130;169;181m"
  if (n <= 3)
    return "\033[38;2;113;140;157m"
  return "\033[38;2;95;117;105m"
}

function tagpaint(tok) {
  if (substr(tok, 1, 1) == "#")
    return "\033[38;2;130;169;181m"
  return "\033[38;2;168;148;181m"
}

function getn(line, kind, tok, q) {
  if (match(line, "(^|[ \t])" kind ":[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]")) {
    tok = substr(line, RSTART, RLENGTH)
    sub(/^[ \t]/, "", tok)
    split(substr(tok, length(kind)+2), q, "-")
    return jd(q[1]+0, q[2]+0, q[3]+0) - t
  }
  return 99999
}

function colorize(line, out, s, len, tok, lead, p, q, n, col) {
  out = ""

  while (match(line, /(^|[ \t])((due|do):[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]|[#@][A-Za-z][A-Za-z0-9_-]*)/)) {
    s = RSTART
    len = RLENGTH
    tok = substr(line, s, len)
    lead = ""

    if (tok ~ /^[ \t]/) {
      lead = substr(tok, 1, 1)
      tok = substr(tok, 2)
    }

    if (tok ~ /^(due|do):/) {
      split(tok, p, ":")
      split(p[2], q, "-")
      n = jd(q[1]+0, q[2]+0, q[3]+0) - t
      col = paint(p[1], n)
    } else {
      col = tagpaint(tok)
    }

    out = out substr(line, 1, s-1) lead col tok "\033[0m"
    line = substr(line, s+len)
  }

  return out line
}

BEGIN {
  t = jd(ty, tm, td)
}
EOF
)

awkrun() {
  awk \
    -v ty="$(date +%Y)" \
    -v tm="$((10#$(date +%m)))" \
    -v td="$((10#$(date +%d)))" \
    "$AWK_LIB
$1" "$TODO"
}

out() {
  if [[ -t 1 ]]; then
    cat
  else
    sed $'s/\033\\[[0-9;]*m//g'
  fi
}

full_list() {
  awkrun '
    {
      printf "%6d\t%s\n", NR, colorize($0)
    }
  ' | out
}

agenda() {
  awkrun '
    /^[ \t]+/ { next }
    $0 !~ /^[ \t]*[-+*] / { next }

    {
      d1 = getn($0, "due")
      d2 = getn($0, "do")
      k = (d1 < d2) ? d1 : d2
      txt = $0
      sub(/^[ \t]*[-+*] (\[ \] )?/, "", txt)

      if (k == 99999) {
        und++
        next
      }

      printf "%d\t%d\t%s\n", k, NR, txt
    }

    END {
      printf "99999\t0\t%d\n", und+0
    }
  ' |
  sort -t$'\t' -k1,1n -k2,2n |
  {
    last=""

    while IFS=$'\t' read -r k nr text; do
      if (( k == 99999 )); then
        (( text > 0 )) &&
          printf '\n%s[2m%s undated items (todo -f to see all)%s[0m\n' \
            "$ESC" "$text" "$ESC"
        continue
      fi

    if (( k < 0 )); then
      g="Overdue"
      c='1;38;2;196;127;136'
    elif (( k == 0 )); then
      g="Today"
      c='1;38;2;216;197;143'
    elif (( k <= 7 )); then
      g="Next 7 days"
      c='38;2;196;183;127'
    else
      g="Later"
      c='38;2;120;151;127'
    fi

      if [[ $g != "$last" ]]; then
        printf '\n%s[%sm%s%s[0m\n' \
          "$ESC" "$c" "$g" "$ESC"
        last=$g
      fi

      colored=$(
        awk \
          -v ty="$(date +%Y)" \
          -v tm="$((10#$(date +%m)))" \
          -v td="$((10#$(date +%d)))" \
          "$AWK_LIB
            { print colorize(\$0) }
          " <<< "$text"
      )

      printf '  %s[2m%3s%s[0m  %s\n' \
        "$ESC" "$nr" "$ESC" "$colored"
    done
  } | out
}

expand_date() {
  local v="$1"

  case "$v" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
      echo "$v"
      ;;
    today|tod)
      date +%F
      ;;
    tom|tomorrow)
      date -d tomorrow +%F
      ;;
    +[0-9]*)
      date -d "${v#+} days" +%F
      ;;
    mon|tue|wed|thu|fri|sat|sun)
      date -d "next $v" +%F
      ;;
    *)
      date -d "$v" +%F
      ;;
  esac 2>/dev/null
}

add_under() {
  local header="$1"
  local item="$2"
  local tmp

  tmp=$(mktemp) || return 1

  awk -v h="$header" -v item="$item" '
    { L[NR] = $0 }

    END {
      start = 0

      for (i = 1; i <= NR; i++)
        if (L[i] == h) {
          start = i
          break
        }

      if (!start)
        exit 2

      last = start

      for (i = start + 1; i <= NR; i++) {
        if (L[i] ~ /^---/ || L[i] ~ /^#+ /)
          break

        if (L[i] !~ /^[ \t]*$/)
          last = i
      }

      for (i = 1; i <= NR; i++) {
        print L[i]
        if (i == last)
          print item
      }
    }
  ' "$TODO" > "$tmp" || {
    rm -f "$tmp"
    return 1
  }

  cat "$tmp" > "$TODO"
  rm -f "$tmp"
}

usage() {
  cat <<'EOF'
Usage:
  todo            Agenda: dated items grouped by urgency
  todo -f         Full list with line numbers
  todo -o         Open in nvim
  todo -a TEXT    Add to Inbox (due:fri, do:tom, due:+3 expand to dates)
  todo -n TEXT    Add to Now
  todo -d LINE    Delete line LINE
EOF
}

case "$1" in
  "")
    agenda
    ;;

  -f)
    full_list
    ;;

  -o)
    nvim "$TODO"
    ;;

  -a|-n)
    flag=$1
    shift

    [[ -z "$*" ]] && {
      echo "Usage: todo $flag TEXT"
      exit 1
    }

    words=()

    for w in "$@"; do
      if [[ $w =~ ^(due|do):(.+)$ ]]; then
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        d=$(expand_date "$val")

        [[ -z "$d" ]] && {
          echo "Can't parse date: $w"
          exit 1
        }

        w="$key:$d"
      fi

      words+=("$w")
    done

    if [[ $flag == -n ]]; then
      section="## Now"
    else
      section="## Inbox"
    fi

    if add_under "$section" "- ${words[*]}"; then
      echo "Added to ${section#\#\# }: ${words[*]}"
    else
      echo "No '$section' header found, appended to end instead."

      [[ -s "$TODO" && -n "$(tail -c1 "$TODO")" ]] &&
        echo >> "$TODO"

      printf -- '- %s\n' "${words[*]}" >> "$TODO"
    fi
    ;;

  -d)
    if [[ ! "$2" =~ ^[0-9]+$ ]]; then
      echo "Usage: todo -d LINE"
      exit 1
    fi

    n=$((10#$2))
    total=$(grep -c '' "$TODO")

    if (( n < 1 || n > total )); then
      echo "Line $n does not exist."
      exit 1
    fi

    line=$(sed -n "${n}p" "$TODO")

    echo "Delete line $n?"
    echo "  $line"

    read -rp "Confirm [y/N]: " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      sed -i "${n}d" "$TODO"
      echo "Deleted line $n."
    else
      echo "Cancelled."
    fi
    ;;

  *)
    usage
    exit 1
    ;;
esac
