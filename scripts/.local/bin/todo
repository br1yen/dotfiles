#!/usr/bin/env bash

TODO="${TODO:-$HOME/sync/notes/todo.md}"
ESC=$'\033'

# ---------------------------------------------------------------
# Shared awk helpers: day math + colors (same palette as nvim)
# ---------------------------------------------------------------
AWK_LIB=$(cat <<'EOF'
function jd(y,m,d) { if (m<=2) { y--; m+=12 } return int(365.25*y)+int(30.6001*(m+1))+d }

function paint(kind, n) {
  if (kind=="due") {
    if (n<0)  return "\033[1;38;2;20;22;27;48;2;255;192;185m" # #14161b on #ffc0b9
    if (n<=1) return "\033[1;38;2;255;192;185m"                 # #ffc0b9
    if (n<=3) return "\033[1;38;2;252;224;148m"                 # #fce094
    if (n<=7) return "\033[38;2;252;224;148m"                   # #fce094
    return "\033[38;2;179;246;192m"                             # #b3f6c0
  }

  if (n<0)  return "\033[1;38;2;255;202;255m"                  # #ffcaff
  if (n==0) return "\033[1;38;2;166;219;255m"                  # #a6dbff
  if (n==1) return "\033[1;38;2;140;248;247m"                  # #8cf8f7
  if (n<=3) return "\033[38;2;166;219;255m"                    # #a6dbff
  return "\033[38;2;79;82;88m"                                # #4f5258
}

# #tag = cyan, @context = purple
function tagpaint(tok) {
  if (substr(tok, 1, 1) == "#") return "\033[38;2;140;248;247m"  # #8cf8f7
  return "\033[38;2;255;202;255m"                                # #ffcaff
}

# days from today for due:/do: in a line, or 99999 if absent
function getn(line, kind,   tok, q) {
  if (match(line, "(^|[ \t])" kind ":[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]")) {
    tok = substr(line, RSTART, RLENGTH)
    sub(/^[ \t]/, "", tok)
    split(substr(tok, length(kind)+2), q, "-")
    return jd(q[1]+0, q[2]+0, q[3]+0) - t
  }
  return 99999
}

# wrap every due:/do: token and #tag/@context in its color
function colorize(line,   out, s, len, tok, lead, p, q, n, col) {
  out = ""
  while (match(line, /(^|[ \t])((due|do):[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]|[#@][A-Za-z][A-Za-z0-9_-]*)/)) {
    s = RSTART; len = RLENGTH
    tok = substr(line, s, len); lead = ""
    if (tok ~ /^[ \t]/) { lead = substr(tok, 1, 1); tok = substr(tok, 2) }
    if (tok ~ /^(due|do):/) {
      split(tok, p, ":"); split(p[2], q, "-")
      n = jd(q[1]+0, q[2]+0, q[3]+0) - t
      col = paint(p[1], n)
    } else {
      col = tagpaint(tok)
    }
    out = out substr(line, 1, s-1) lead col tok "\033[0m"
    line = substr(line, s+len)
  }
  return out line
}

BEGIN { t = jd(ty, tm, td) }
EOF
)

awkrun() {
  awk -v ty="$(date +%Y)" -v tm="$((10#$(date +%m)))" -v td="$((10#$(date +%d)))" \
    "$AWK_LIB
$1" "$TODO"
}

# strip colors when output isn't a terminal (so `todo | grep` stays clean)
out() { if [[ -t 1 ]]; then cat; else sed "s/${ESC}\[[0-9;]*m//g"; fi; }

# ---------------------------------------------------------------
# Views
# ---------------------------------------------------------------
full_list() {
  awkrun '{ printf "%6d\t%s\n", NR, colorize($0) }' | out
}

agenda() {
  awkrun '
    /^[ \t]+/ { next }
    $0 !~ /^[ \t]*[-+*] / { next }
    {
      d1 = getn($0, "due"); d2 = getn($0, "do")
      k = (d1 < d2) ? d1 : d2          # earliest of due/do
      txt = $0; sub(/^[ \t]*[-+*] (\[ \] )?/, "", txt)
      if (k == 99999) { und++; next }
      printf "%d\t%d\t%s\n", k, NR, colorize(txt)
    }
    END { printf "99999\t0\t%d\n", und+0 }
  ' | sort -t$'\t' -k1,1n -k2,2n | {
    last=""
    while IFS=$'\t' read -r k nr text; do
      if (( k == 99999 )); then
        (( text > 0 )) && printf '\n%s[2m%s undated items (todo -f to see all)%s[0m\n' "$ESC" "$text" "$ESC"
        continue
      fi
if   (( k < 0 ));  then g="Overdue";     c='1;38;2;255;192;185'
elif (( k == 0 )); then g="Today";       c='1;38;2;166;219;255'
elif (( k <= 7 )); then g="Next 7 days"; c='1;38;2;252;224;148'
else                    g="Later";       c='1;38;2;179;246;192'
fi
      if [[ $g != "$last" ]]; then
        printf '\n%s[%sm%s%s[0m\n' "$ESC" "$c" "$g" "$ESC"
        last=$g
      fi
      printf '  %s[2m%3s%s[0m  %s\n' "$ESC" "$nr" "$ESC" "$text"
    done
  } | out
}

# ---------------------------------------------------------------
# Quick-add helpers (GNU date; on macOS install coreutils -> gdate)
# ---------------------------------------------------------------
expand_date() {
  local v="$1"
  case "$v" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) echo "$v" ;;
    today|tod)                                  date +%F ;;
    tom|tomorrow)                               date -d tomorrow +%F ;;
    +[0-9]*)                                    date -d "${v#+} days" +%F ;;
    mon|tue|wed|thu|fri|sat|sun)                date -d "next $v" +%F ;;
    *)                                          date -d "$v" +%F ;;
  esac 2>/dev/null
}

# add_under "## Header" "- item text"
# inserts after the last non-blank line of that section
# (so after any indented sub-items, before the next --- or header)
add_under() {
  local header="$1" item="$2" tmp
  tmp=$(mktemp) || return 1
  awk -v h="$header" -v item="$item" '
    { L[NR] = $0 }
    END {
      start = 0
      for (i = 1; i <= NR; i++) if (L[i] == h) { start = i; break }
      if (!start) exit 2
      last = start
      for (i = start + 1; i <= NR; i++) {
        if (L[i] ~ /^---/ || L[i] ~ /^#+ /) break
        if (L[i] !~ /^[ \t]*$/) last = i
      }
      for (i = 1; i <= NR; i++) { print L[i]; if (i == last) print item }
    }' "$TODO" > "$tmp" || { rm -f "$tmp"; return 1; }
  cat "$tmp" > "$TODO"    # cat, not mv, so sync/symlinks/permissions stay intact
  rm -f "$tmp"
}

usage() {
  cat <<'EOF'
Usage:
  todo            Agenda: dated items grouped by urgency
  todo -f         Full list with line numbers
  todo -o         Open in nvim
  todo -a TEXT    Add to Inbox (due:fri, do:tom, due:+3 expand to dates)
  todo -n TEXT    Add to Now
  todo -d LINE    Delete line LINE
EOF
}

# ---------------------------------------------------------------
case "$1" in
    "")
        agenda
        ;;

    -f)
        full_list
        ;;

    -o)
        nvim "$TODO"
        ;;

    -a|-n)
        flag=$1; shift
        [[ -z "$*" ]] && { echo "Usage: todo $flag TEXT"; exit 1; }
        words=()
        for w in "$@"; do
            if [[ $w =~ ^(due|do):(.+)$ ]]; then
                key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
                d=$(expand_date "$val")
                [[ -z "$d" ]] && { echo "Can't parse date: $w"; exit 1; }
                w="$key:$d"
            fi
            words+=("$w")
        done

        if [[ $flag == -n ]]; then section="## Now"; else section="## Inbox"; fi

        if add_under "$section" "- ${words[*]}"; then
            echo "Added to ${section#\#\# }: ${words[*]}"
        else
            echo "No '$section' header found, appended to end instead."
            [[ -s "$TODO" && -n "$(tail -c1 "$TODO")" ]] && echo >> "$TODO"
            printf -- '- %s\n' "${words[*]}" >> "$TODO"
        fi
        ;;

    -d)
        if [[ ! "$2" =~ ^[0-9]+$ ]]; then
            echo "Usage: todo -d LINE"
            exit 1
        fi

        n=$((10#$2))
        total=$(grep -c '' "$TODO")

        if (( n < 1 || n > total )); then
            echo "Line $n does not exist."
            exit 1
        fi

        line=$(sed -n "${n}p" "$TODO")

        echo "Delete line $n?"
        echo "  $line"
        read -rp "Confirm [y/N]: " confirm

        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            sed -i "${n}d" "$TODO"
            echo "Deleted line $n."
        else
            echo "Cancelled."
        fi
        ;;

    *)
        usage
        exit 1
        ;;
esac
