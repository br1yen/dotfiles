#!/usr/bin/env bash

TODO="$HOME/sync/notes/todo.md"

case "$1" in
    "")
        cat -n "$TODO"
        ;;

    -o)
        nvim "$TODO"
        ;;

    -d)
        if [[ ! "$2" =~ ^[0-9]+$ ]]; then
            echo "Usage: todo -d LINE"
            exit 1
        fi

        n=$((10#$2))                  # normalize (handles 08, 007, ...)
        total=$(grep -c '' "$TODO")   # line count, even without trailing newline

        if (( n < 1 || n > total )); then
            echo "Line $n does not exist."
            exit 1
        fi

        line=$(sed -n "${n}p" "$TODO")

        echo "Delete line $n?"
        echo "  $line"
        read -rp "Confirm [y/N]: " confirm

        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            sed -i "${n}d" "$TODO"
            echo "Deleted line $n."
        else
            echo "Cancelled."
        fi
        ;;

    *)
        echo "Usage:"
        echo "  todo           Show todo list"
        echo "  todo -o        Open todo list in nvim"
        echo "  todo -d LINE   Delete line LINE"
        exit 1
        ;;
esac
