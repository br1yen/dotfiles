#!/usr/bin/env bash

dir="${1:-$HOME/sync/notes}"

if command -v fd >/dev/null 2>&1; then
    list() { fd --type f --extension pdf --absolute-path . "$dir"; }
else
    list() { find "$dir" -type f -iname '*.pdf' 2>/dev/null; }
fi

# Show ~ instead of the full home path to keep entries short
selection=$(list | sed "s|^$HOME|~|" | fuzzel --dmenu --prompt='pdf> ' --width=80 --lines=15)

[ -z "$selection" ] && exit 0

# Expand ~ back to $HOME
selection="${selection/#\~/$HOME}"

setsid -f sioyek "$selection" >/dev/null 2>&1
