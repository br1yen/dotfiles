#!/usr/bin/env bash

selected=$(
    hyprctl clients -j |
        jq -r '.[] | "\(.address)\t\(.class // "") — \(.title // "")"' |
        awk -F'\t' '{
            title = $2
            if (length(title) > 40) title = substr(title, 1, 37) "..."
            print $1 "\t" NR ". " title
        }' |
        fuzzel --dmenu \
            --prompt 'Window: ' \
            --with-nth 2 \
            --accept-nth 1
)

[ -z "$selected" ] && exit 0

hyprctl dispatch "hl.dsp.focus({ window = \"address:$selected\" })"
