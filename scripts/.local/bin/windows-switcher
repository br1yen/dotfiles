#!/usr/bin/env bash

selected=$(
    hyprctl clients -j |
        jq -r '.[] | "\(.address)\t\(.class // "") — \(.title // "")"' |
        fuzzel --dmenu \
            --prompt 'Window: ' \
            --with-nth 2 \
            --accept-nth 1
)

[ -z "$selected" ] && exit 0

hyprctl dispatch "hl.dsp.focus({ window = \"address:$selected\" })"
