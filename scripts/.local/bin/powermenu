#!/bin/sh

choice=$(
  printf '%s\n' 'Lock' 'Suspend' 'Log out' 'Reboot' 'Shut down' |
  /usr/bin/fuzzel --dmenu --prompt 'Power: '
)

case "$choice" in
  Lock)
    /usr/bin/loginctl lock-session
    ;;
  Suspend)
    /usr/bin/systemctl suspend
    ;;
  'Log out')
    if command -v hyprshutdown >/dev/null 2>&1; then
      hyprshutdown
    else
      /usr/bin/hyprctl dispatch 'hl.dsp.exit()'
    fi
    ;;
  Reboot)
    /usr/bin/systemctl reboot
    ;;
  'Shut down')
    /usr/bin/systemctl poweroff
    ;;
esac
