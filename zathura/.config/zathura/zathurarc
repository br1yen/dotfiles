# UI
set recolor true
set recolor-keephue true

set guioptions none
set window-title-basename true

set statusbar-h-padding 8
set statusbar-v-padding 6

# Adwaita Dark
set default-bg "#242424"
set default-fg "#dedede"

set recolor-lightcolor "#242424"
set recolor-darkcolor "#dedede"

set statusbar-bg "#242424"
set statusbar-fg "#dedede"

set inputbar-bg "#242424"
set inputbar-fg "#dedede"

set notification-bg "#303030"
set notification-fg "#dedede"

set notification-error-bg "#303030"
set notification-error-fg "#ff7b7b"

set notification-warning-bg "#303030"
set notification-warning-fg "#ffcc66"

set highlight-color "#3d3d3d"
set highlight-active-color "#3584e4"

set font "Hack 12"

# Behavior
set selection-clipboard clipboard
set adjust-open width
set scroll-step 100

# Open PDFs at the last position
set database sqlite

# Keybindings
map J scroll half-down
map K scroll half-up
map H navigate previous
map L navigate next
map r reload
map q quit
