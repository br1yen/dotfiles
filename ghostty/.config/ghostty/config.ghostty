font-family = Courier Prime
adjust-cell-height = 2
font-size = 12
scrollback-limit = 10000

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
# custom-shader = shaders/cursor/cursor_warp.glsl
# custom-shader-animation = true

background = #FAF2EB
foreground = #1A1918
selection-background = #CCCBC6
selection-foreground = #1A1918

cursor-color = #1A1918
cursor-text = #FAF2EB
palette = 0=#1A1918
palette = 1=#A60000
palette = 2=#00A600
palette = 3=#8A6A00
palette = 4=#0000A6
palette = 5=#6F00A6
palette = 6=#00A6A6
palette = 7=#FAF2EB
palette = 8=#8F8A83
palette = 9=#A60000
palette = 10=#00A600
palette = 11=#8A6A00
palette = 12=#0000A6
palette = 13=#6F00A6
palette = 14=#00A6A6
palette = 15=#FAF2EB

confirm-close-surface = false
bell-features = false
app-notifications = no-clipboard-copy
copy-on-select = true
resize-overlay = never
right-click-action = ignore
