font-family = Hack
font-size = 14

window-padding-x = 4
window-padding-y = 4
background-opacity = 1.0

scrollback-limit = 10000

cursor-style = block
cursor-style-blink = false

background = #000000
foreground = #ECE1D7
cursor-color = #ECE1D7
selection-background = #403A36
selection-foreground = #ECE1D7
palette = 0=#34302C
palette = 1=#BD8183
palette = 2=#78997A
palette = 3=#E49B5D
palette = 4=#7F91B2
palette = 5=#B380B0
palette = 6=#7B9695
palette = 7=#C1A78E
palette = 8=#867462
palette = 9=#D47766
palette = 10=#85B695
palette = 11=#EBC06D
palette = 12=#A3A9CE
palette = 13=#CF9BC2
palette = 14=#89B3B6
palette = 15=#ECE1D7

confirm-close-surface = false
bell-features = false
app-notifications = no-clipboard-copy
copy-on-select = true
resize-overlay = never
mouse-scroll-multiplier = precision:1
mouse-hide-while-typing = true
right-click-action = ignore
