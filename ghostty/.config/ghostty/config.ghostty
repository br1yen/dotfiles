font-family = Inconsolata
font-size = 14

window-padding-y = 0
window-padding-x = 0

clipboard-write = allow
clipboard-read = deny

confirm-close-surface = false
scrollback-limit = 25000000

resize-overlay = never
app-notifications = no-clipboard-copy,no-config-reload

cursor-style = block
cursor-style-blink = false
cursor-color = #bfad9e
cursor-text = #1a1a1a
shell-integration-features = no-cursor
bell-features = no-system,no-audio,no-attention,no-title,no-border

mouse-scroll-multiplier = precision:0.8,discrete:1
custom-shader = shaders/cursor-warp.glsl
custom-shader-animation = true

background = #1a1a1a
foreground = #dadada
selection-background = #2d2d2d
selection-foreground = #c0af8c

palette = 0=#1a1a1a
palette = 1=#d29393
palette = 2=#b3b393
palette = 3=#cbaa89
palette = 4=#a8a1be
palette = 5=#b39fb0
palette = 6=#c0af8c
palette = 7=#dadada
palette = 8=#5b5b5b
palette = 9=#c95954
palette = 10=#828040
palette = 11=#a6794c
palette = 12=#5a6599
palette = 13=#9c6995
palette = 14=#74a39e
palette = 15=#ffffff
