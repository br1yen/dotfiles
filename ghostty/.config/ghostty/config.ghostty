font-family = Hack
font-size = 14

window-padding-x = 4
window-padding-y = 4
background-opacity = 1

scrollback-limit = 10000

cursor-style = block
cursor-style-blink = false

background = #000000
foreground = #cdcdcd

palette = 0=#000000
palette = 1=#d8647e
palette = 2=#7fa563
palette = 3=#f3be7c
palette = 4=#6e94b2
palette = 5=#bb9dbd
palette = 6=#aeaed1
palette = 7=#cdcdcd

palette = 8=#606079
palette = 9=#e68e9d
palette = 10=#a8c98a
palette = 11=#f6d6a8
palette = 12=#7e98e8
palette = 13=#c9afd0
palette = 14=#b4d4cf
palette = 15=#eeeeee

confirm-close-surface = false
bell-features = false
app-notifications = no-clipboard-copy
copy-on-select = true
resize-overlay = never
mouse-scroll-multiplier = precision:1
mouse-hide-while-typing = true
right-click-action = ignore
