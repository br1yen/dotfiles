{
  "layer": "top",
  "position": "top",
  "spacing": 4,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "battery",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 40,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%a %b %d   %I:%M %p}",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}% ",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["", "", ""]
    }
  },

"battery": {
    "format": " {icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂"]
},

  "tray": {
    "spacing": 8
  }
}
