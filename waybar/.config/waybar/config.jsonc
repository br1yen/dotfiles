{
  "layer": "top",
  "position": "top",
  "spacing": 4,

  "modules-left": [
    "hyprland/workspaces",
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "battery",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name} {windows}",
    "window-rewrite-default": "?",
    "window-rewrite-separator": "",
    "window-rewrite": {
      "class<librewolf>": "web",
      "class<com.mitchellh.ghostty>": "term",
      "class<cs2>": "cs2",
      "class<steam>": "steam",
      "title<.*nvim.*>": "nvim",
      "class<md.obsidian.Obsidian>": "notes",
      "class<sioyek>": "pdf",
      "class<thunar>": "files",
      "class<emacs>": "emacs",
    }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 40,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%a %d %b   %I:%M %p}",
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": [" ", " ", " "]
    },
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "battery": {
    "format": " {icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂"],
    "tooltip": false
  },

  "tray": {
    "spacing": 8,
    "tooltip": false
  }
}
